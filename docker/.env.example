# Copy this file to .env only on the deployment host. Never commit the real file.
WATER_ACCESS_PIN=change-me
WATER_WORKSPACE_HOST_PATH=/absolute/path/to/workspace
WATER_UID=1000
WATER_GID=1000
WATER_WEB_BIND_ADDRESS=127.0.0.1
WATER_WEB_PORT=13013
WATER_IMAGE_TAG=latest
TZ=Asia/Shanghai
WATER_DOCUMENT_ENGINE=native
