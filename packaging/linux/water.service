[Unit]
Description=若水 Water self-hosted AI coding agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@WORKING_DIR@
EnvironmentFile=-@ENV_FILE@
Environment="HOME=@DATA_DIR@/home"
Environment="PATH=@INSTALL_DIR@/runtime/go/bin:@INSTALL_DIR@/runtime/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=@INSTALL_DIR@/water --config @CONFIG_FILE@
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
