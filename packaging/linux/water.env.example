# Copy or edit this file on the target Linux host. Never commit the real file.
# Set a stable PIN before first start, or let Water generate one in the service log.
WATER_ACCESS_PIN=change-me
WATER_HTTP_ADDR=:8080
WATER_DATA_DIR=/var/lib/water
WATER_DATABASE_PATH=/var/lib/water/water.db
WATER_DOCUMENT_ENGINE=native
HOME=/var/lib/water/home
PATH=/opt/water/runtime/go/bin:/opt/water/runtime/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
